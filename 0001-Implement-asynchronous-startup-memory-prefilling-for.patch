+++			// Start new range
+++			startIdx = idx
+++			endIdx = idx + 1
+++			firstOrder = order
+++			previousOrder = order
+++			hits = 1
+++		}
+++	}
+++
+++	// Commit last range
+++	ranges = append(ranges, Range{
+++		Offset: startIdx * PageSize,
+++		Length: (endIdx - startIdx) * PageSize,
+++		Order:  firstOrder,
+++		Hits:   hits,
+++	})
