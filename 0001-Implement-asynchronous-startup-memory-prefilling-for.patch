+++	return &MemoryProfile{
+++		Version:  CurrentVersion,
+++		PageSize: PageSize,
+++		WindowMs: 2000,
+++		Targets: []Target{
+++			{
+++				Kind:   "memory",
+++				Size:   memorySize,
+++				Ranges: ranges,
+++			},
+++		},
+++	}
+++}
