+++		r.RecordResolved(page * PageSize)
+++	}
+++	got := r.Freeze(8 * PageSize).MemoryTarget().Ranges
+++	if len(got) != 4 || got[0].Offset != 0 || got[1].Offset != 2*PageSize || got[2].Offset != PageSize || got[3].Offset != 3*PageSize || got[3].Length != 2*PageSize {
