diff --git a/pkg/prefill/prefill.go b/pkg/prefill/prefill.go
new file mode 100644
index 0000000..23380df
--- /dev/null
+++ b/pkg/prefill/prefill.go
@@ -0,0 +1,326 @@
+// Package prefill loads profiled snapshot pages through UFFDIO_COPY while
+// cloud-hypervisor is restoring. Fetch workers overlap CH restore, while the
+// caller keeps vCPUs paused until this bounded operation completes.
+package prefill
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/kuasar-sandbox/sandboxer/pkg/profile"
+	"github.com/kuasar-sandbox/sandboxer/pkg/uffd"
+)
+
+type PrefillOptions struct {
+	MaxBytes uint64
+	// BufferBytes bounds data fetched before UFFD regions are ready.
+	// Zero uses a 64 MiB default; values below MaxBatchBytes are rounded up.
+	BufferBytes uint64
+	Timeout     time.Duration
+	Workers     int
+}
+
+type PrefillStats struct {
+	RequestedRanges uint64
+	CompletedRanges uint64
+	SkippedZero     uint64
+	BytesRequested  uint64
+	BytesFilled     uint64
+	BytesExisting   uint64
+	FetchErrors     uint64
+	BudgetExhausted bool
+	Duration        time.Duration
+}
+
+type fetchJob struct {
+	seq       uint64
+	rangeSeq  uint64
+	offset    uint64
+	length    uint64
+	lastRange bool
+}
+
+type fetchedSpan struct {
+	offset uint64
+	length uint64
+	zero   bool
+}
+
+type fetchResult struct {
+	job   fetchJob
+	data  []byte
+	spans []fetchedSpan
+	err   error
+}
+
+// Plan is a bounded two-stage startup prefill. Prepare starts remote reads as
+// soon as the snapshot source and profile exist; Inject later installs the
+// ordered results after CH reports its UFFD regions.
+type Plan struct {
+	ctx       context.Context
+	cancel    context.CancelFunc
+	results   chan fetchResult
+	slots     chan struct{}
+	done      chan struct{}
+	closeOnce sync.Once
+
+	requestedRanges uint64
+	requestedBytes  uint64
+	budgetExhausted bool
+	started         time.Time
+}
+
+// Prepare begins ordered, bounded profile fetching. Jobs reserve a buffer slot
+// before dispatch, in profile order, so later ranges cannot consume all memory
+// and starve the earliest range. Each slot is at most MaxBatchBytes.
+func Prepare(ctx context.Context, baseSource uffd.SnapshotReader, prof *profile.MemoryProfile, opts PrefillOptions) *Plan {
+	if baseSource == nil || prof == nil || opts.MaxBytes == 0 {
+		return nil
+	}
+	target := prof.MemoryTarget()
+	if target == nil {
+		return nil
+	}
+	selected, reserved, exhausted := selectRanges(target.Ranges, opts.MaxBytes)
+	if len(selected) == 0 {
+		return nil
+	}
+	workers := opts.Workers
+	if workers <= 0 {
+		workers = 8
+	}
+	bufferBytes := opts.BufferBytes
+	if bufferBytes == 0 {
+		bufferBytes = 64 << 20
+	}
+	if bufferBytes < uffd.MaxBatchBytes {
+		bufferBytes = uffd.MaxBatchBytes
+	}
+	slotCount := int(bufferBytes / uffd.MaxBatchBytes)
+	if slotCount < 1 {
+		slotCount = 1
+	}
+	if workers > slotCount {
+		workers = slotCount
+	}
+
+	planCtx, cancel := context.WithCancel(ctx)
+	p := &Plan{
+		ctx:             planCtx,
+		cancel:          cancel,
+		results:         make(chan fetchResult, slotCount),
+		slots:           make(chan struct{}, slotCount),
+		done:            make(chan struct{}),
+		requestedRanges: uint64(len(selected)),
+		requestedBytes:  reserved,
+		budgetExhausted: exhausted,
+		started:         time.Now(),
+	}
+	jobs := make(chan fetchJob)
+	source := baseSource.CloneWithContext(planCtx)
+	var workersWG sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		workersWG.Add(1)
+		go func() {
+			defer workersWG.Done()
+			for job := range jobs {
+				result := fetchResult{job: job, data: make([]byte, int(job.length))}
+				for cursor := uint64(0); cursor < job.length; {
+					n, zero, err := source.ReadAt(result.data[cursor:], job.offset+cursor)
+					if err != nil || n == 0 {
+						if err == nil {
+							err = context.Canceled
+						}
+						result.err = err
+						break
+					}
+					result.spans = append(result.spans, fetchedSpan{offset: cursor, length: uint64(n), zero: zero})
+					cursor += uint64(n)
+				}
+				select {
+				case p.results <- result:
+				case <-planCtx.Done():
+					return
+				}
+			}
+		}()
+	}
+	go func() {
+		defer close(jobs)
+		var seq uint64
+		for rangeSeq, r := range selected {
+			for off, end := r.Offset, r.Offset+r.Length; off < end; {
+				length := end - off
+				if length > uffd.MaxBatchBytes {
+					length = uffd.MaxBatchBytes
+				}
+				select {
+				case p.slots <- struct{}{}:
+				case <-planCtx.Done():
+					return
+				}
+				job := fetchJob{seq: seq, rangeSeq: uint64(rangeSeq), offset: off, length: length, lastRange: off+length == end}
+				select {
+				case jobs <- job:
+				case <-planCtx.Done():
+					<-p.slots
+					return
+				}
+				seq++
+				off += length
+			}
+		}
+	}()
+	go func() {
+		workersWG.Wait()
+		close(p.results)
+		close(p.done)
+	}()
+	return p
+}
+
+// Inject consumes prepared chunks in profile order. Cancelling ctx stops both
+// stages; no UFFDIO_COPY can continue after this method returns.
+func (p *Plan) Inject(ctx context.Context, h *uffd.Handler) PrefillStats {
+	if p == nil || h == nil {
+		return PrefillStats{}
+	}
+	stats := PrefillStats{RequestedRanges: p.requestedRanges, BytesRequested: p.requestedBytes, BudgetExhausted: p.budgetExhausted}
+	pending := make(map[uint64]fetchResult)
+	failedRanges := make(map[uint64]bool)
+	var next uint64
+	for {
+		if ctx.Err() != nil {
+			p.cancel()
+			stats.Duration = time.Since(p.started)
+			return stats
+		}
+		result, ok := pending[next]
+		if !ok {
+			select {
+			case result, ok = <-p.results:
+				if !ok {
+					stats.Duration = time.Since(p.started)
+					return stats
+				}
+				if result.job.seq != next {
+					pending[result.job.seq] = result
+					continue
+				}
+			case <-ctx.Done():
+				p.cancel()
+				stats.Duration = time.Since(p.started)
+				return stats
+			}
+		} else {
+			delete(pending, next)
+		}
+
+		if result.err != nil {
+			stats.FetchErrors++
+			failedRanges[result.job.rangeSeq] = true
+		} else {
+			for _, span := range result.spans {
+				if span.zero {
+					stats.SkippedZero += span.length
+					continue
+				}
+				start, end := span.offset, span.offset+span.length
+				filled, existing, err := h.PrefillCopy(ctx, result.job.offset+start, result.data[start:end])
+				stats.BytesFilled += filled
+				stats.BytesExisting += existing
+				if err != nil {
+					stats.FetchErrors++
+					failedRanges[result.job.rangeSeq] = true
+					break
+				}
+			}
+		}
+		if result.job.lastRange && !failedRanges[result.job.rangeSeq] {
+			stats.CompletedRanges++
+		}
+		<-p.slots
+		next++
+	}
+}
+
+// CanceledStats returns the plan metadata when cancellation happens before a
+// UFFD handler becomes available. Fetch workers never own UFFD injection, so
+// their eventual cleanup is intentionally kept out of the vm.resume gate.
+func (p *Plan) CanceledStats() PrefillStats {
+	if p == nil {
+		return PrefillStats{}
+	}
+	return PrefillStats{
+		RequestedRanges: p.requestedRanges,
+		BytesRequested:  p.requestedBytes,
+		BudgetExhausted: p.budgetExhausted,
+		Duration:        time.Since(p.started),
+	}
+}
+
+// Close cancels and joins an unused or partially consumed plan.
+func (p *Plan) Close() {
+	if p == nil {
+		return
+	}
+	p.closeOnce.Do(func() {
+		p.cancel()
+		<-p.done
+		// No producer remains after done. Drop every buffered result so its
+		// plaintext payload becomes unreachable immediately instead of being
+		// retained by Plan until the restored VM exits.
+		for range p.results {
+		}
+	})
+}
+
+// PrefillStartup fetches independent canonical ranges concurrently and injects
+// them through the CH-side userfaultfds. UFFDIO_COPY is the ownership arbiter:
+// EEXIST means CH already materialized the page, so prefill counts it and
+// moves on without touching existing data. EAGAIN is retried by PrefillCopy.
+func PrefillStartup(ctx context.Context, h *uffd.Handler, baseSource uffd.SnapshotReader, prof *profile.MemoryProfile, opts PrefillOptions) PrefillStats {
+	plan := Prepare(ctx, baseSource, prof, opts)
+	if plan == nil {
+		return PrefillStats{}
+	}
+	defer plan.Close()
+	prefillCtx := ctx
+	cancel := func() {}
+	if opts.Timeout > 0 {
+		prefillCtx, cancel = context.WithTimeout(ctx, opts.Timeout)
+	}
+	defer cancel()
+	return plan.Inject(prefillCtx, h)
+}
+
+func selectRanges(input []profile.Range, maxBytes uint64) ([]profile.Range, uint64, bool) {
+	ranges := append([]profile.Range(nil), input...)
+	sort.SliceStable(ranges, func(i, j int) bool {
+		if ranges[i].Order == ranges[j].Order {
+			return ranges[i].Offset < ranges[j].Offset
+		}
+		return ranges[i].Order < ranges[j].Order
+	})
+	selected := make([]profile.Range, 0, len(ranges))
+	exhausted := false
+	var reserved uint64
+	for _, r := range ranges {
+		remaining := maxBytes - reserved
+		if r.Length > remaining {
+			exhausted = true
+			// Preserve the earliest page-aligned prefix instead of dropping an
+			// oversized hot range wholesale.
+			remaining -= remaining % profile.PageSize
+			if remaining == 0 {
+				continue
+			}
+			r.Length = remaining
+		}
+		selected = append(selected, r)
+		reserved += r.Length
+	}
+	return selected, reserved, exhausted
+}
diff --git a/pkg/prefill/prefill_test.go b/pkg/prefill/prefill_test.go
new file mode 100644
index 0000000..4830fac
--- /dev/null
+++ b/pkg/prefill/prefill_test.go
@@ -0,0 +1,132 @@
+package prefill
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/kuasar-sandbox/sandboxer/pkg/profile"
+	"github.com/kuasar-sandbox/sandboxer/pkg/uffd"
+)
+
+type countingSource struct{ reads atomic.Uint64 }
+
+func (s *countingSource) ReadAt(buf []byte, _ uint64) (int, bool, error) {
+	s.reads.Add(1)
+	for i := range buf {
+		buf[i] = 1
+	}
+	return len(buf), false, nil
+}
+
+func (s *countingSource) CloneWithContext(context.Context) uffd.SnapshotReader { return s }
+
+type blockingSource struct {
+	started chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (s *blockingSource) ReadAt(buf []byte, _ uint64) (int, bool, error) {
+	s.once.Do(func() { close(s.started) })
+	// Deliberately ignore cancellation to model a transport that is slow to
+	// abort. Its cleanup must not remain on the vm.resume critical path.
+	<-s.release
+	return len(buf), false, nil
+}
+
+func (s *blockingSource) CloneWithContext(context.Context) uffd.SnapshotReader { return s }
+
+func TestSelectRangesHonorsOrderAndBudget(t *testing.T) {
+	in := []profile.Range{{Offset: 0x3000, Length: 0x1000, Order: 3}, {Offset: 0x1000, Length: 0x2000, Order: 1}, {Offset: 0, Length: 0x1000, Order: 0}}
+	got, bytes, exhausted := selectRanges(in, 0x3000)
+	if !exhausted || bytes != 0x3000 || len(got) != 2 || got[0].Order != 0 || got[1].Order != 1 {
+		t.Fatalf("got=%+v bytes=%x exhausted=%v", got, bytes, exhausted)
+	}
+}
+
+func TestSelectRangesKeepsOversizedHotPrefix(t *testing.T) {
+	got, bytes, exhausted := selectRanges([]profile.Range{{Offset: 0, Length: 4 * profile.PageSize, Order: 0}}, 2*profile.PageSize)
+	if !exhausted || bytes != 2*profile.PageSize || len(got) != 1 || got[0].Length != 2*profile.PageSize {
+		t.Fatalf("got=%+v bytes=%d exhausted=%v", got, bytes, exhausted)
+	}
+}
+
+func TestPrepareFetchesBeforeInjectAndRespectsBuffer(t *testing.T) {
+	source := &countingSource{}
+	prof := &profile.MemoryProfile{Version: profile.CurrentVersion, PageSize: profile.PageSize, Targets: []profile.Target{{
+		Kind: "memory", Size: 4 * uffd.MaxBatchBytes,
+		Ranges: []profile.Range{{Offset: 0, Length: 4 * uffd.MaxBatchBytes, Order: 0}},
+	}}}
+	plan := Prepare(context.Background(), source, prof, PrefillOptions{
+		MaxBytes:    4 * uffd.MaxBatchBytes,
+		BufferBytes: 2 * uffd.MaxBatchBytes,
+		Workers:     8,
+	})
+	if plan == nil {
+		t.Fatal("Prepare returned nil")
+	}
+
+	deadline := time.Now().Add(time.Second)
+	for source.reads.Load() < 2 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if got := source.reads.Load(); got != 2 {
+		t.Fatalf("early reads=%d want=2", got)
+	}
+	// Without Inject releasing slots, later jobs must not allocate/fetch.
+	time.Sleep(20 * time.Millisecond)
+	if got := source.reads.Load(); got != 2 {
+		t.Fatalf("buffer bound allowed %d reads, want 2", got)
+	}
+	plan.Close()
+	if got := len(plan.results); got != 0 {
+		t.Fatalf("Close retained %d buffered results", got)
+	}
+}
+
+func TestInjectCancellationDoesNotJoinBlockedFetch(t *testing.T) {
+	source := &blockingSource{started: make(chan struct{}), release: make(chan struct{})}
+	prof := &profile.MemoryProfile{Version: profile.CurrentVersion, PageSize: profile.PageSize, Targets: []profile.Target{{
+		Kind: "memory", Size: uffd.MaxBatchBytes,
+		Ranges: []profile.Range{{Offset: 0, Length: uffd.MaxBatchBytes, Order: 0}},
+	}}}
+	plan := Prepare(context.Background(), source, prof, PrefillOptions{
+		MaxBytes:    uffd.MaxBatchBytes,
+		BufferBytes: uffd.MaxBatchBytes,
+		Workers:     1,
+	})
+	if plan == nil {
+		t.Fatal("Prepare returned nil")
+	}
+
+	select {
+	case <-source.started:
+	case <-time.After(time.Second):
+		t.Fatal("fetch did not start")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	returned := make(chan PrefillStats, 1)
+	go func() {
+		returned <- plan.Inject(ctx, &uffd.Handler{})
+	}()
+	cancel()
+	select {
+	case stats := <-returned:
+		if stats.BytesRequested != uffd.MaxBatchBytes {
+			t.Fatalf("BytesRequested=%d, want %d", stats.BytesRequested, uffd.MaxBatchBytes)
+		}
+	case <-time.After(100 * time.Millisecond):
+		t.Fatal("Inject waited for blocked fetch worker after cancellation")
+	}
+	select {
+	case <-plan.done:
+		t.Fatal("blocked fetch unexpectedly finished; test did not exercise asynchronous cleanup")
+	default:
+	}
+
+	close(source.release)
+	plan.Close()
+}
diff --git a/pkg/profile/profile.go b/pkg/profile/profile.go
new file mode 100644
index 0000000..8bdf238
--- /dev/null
+++ b/pkg/profile/profile.go
@@ -0,0 +1,124 @@
+// Package profile provides data structures and parsing logic for the startup profile.
+// The startup profile is a JSON document generated during a cold start that records
+// the memory pages accessed by the guest. During a subsequent restore, this profile
+// is used to asynchronously prefill the hot memory pages to reduce UFFD latency.
+package profile
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+)
+
+const (
+	// CurrentVersion is the supported version of the startup profile format.
+	CurrentVersion = 1
+	// PageSize is the assumed memory page size (4 KiB).
+	PageSize        = 4096
+	MaxProfileBytes = 1 << 20
+	MaxRanges       = 32768
+)
+
+// Range represents a continuous block of memory accessed during cold start.
+type Range struct {
+	Offset uint64 `json:"offset"`
+	Length uint64 `json:"length"`
+	Order  uint32 `json:"order"`
+	Hits   uint32 `json:"hits"`
+}
+
+// Target represents a specific profiling target (e.g., "memory").
+type Target struct {
+	Kind   string  `json:"kind"`
+	Size   uint64  `json:"size"`
+	Ranges []Range `json:"ranges"`
+}
+
+// MemoryProfile is the top-level structure of the startup-profile.json file.
+type MemoryProfile struct {
+	Version  int      `json:"version"`
+	PageSize int      `json:"page_size"`
+	WindowMs int      `json:"window_ms"`
+	Targets  []Target `json:"targets"`
+}
+
+// Parse unmarshals the JSON profile and performs basic validation.
+func Parse(data []byte, expectedMemorySize uint64) (*MemoryProfile, error) {
+	if len(data) > MaxProfileBytes {
+		return nil, fmt.Errorf("profile exceeds %d bytes", MaxProfileBytes)
+	}
+	var prof MemoryProfile
+	if err := json.Unmarshal(data, &prof); err != nil {
+		return nil, fmt.Errorf("failed to unmarshal profile: %w", err)
+	}
+
+	if prof.Version != CurrentVersion {
+		return nil, fmt.Errorf("unsupported profile version: %d", prof.Version)
+	}
+	if prof.PageSize != PageSize {
+		return nil, fmt.Errorf("unsupported page size: %d", prof.PageSize)
+	}
+
+	var memoryTarget *Target
+	for i := range prof.Targets {
+		if prof.Targets[i].Kind == "memory" {
+			if memoryTarget != nil {
+				return nil, fmt.Errorf("multiple memory targets found in profile")
+			}
+			memoryTarget = &prof.Targets[i]
+		}
+	}
+
+	if memoryTarget == nil {
+		return nil, fmt.Errorf("no memory target found in profile")
+	}
+
+	if memoryTarget.Size != expectedMemorySize {
+		return nil, fmt.Errorf("profile memory size (%d) does not match expected size (%d)", memoryTarget.Size, expectedMemorySize)
+	}
+
+	if len(memoryTarget.Ranges) > MaxRanges {
+		return nil, fmt.Errorf("profile has too many ranges: %d", len(memoryTarget.Ranges))
+	}
+	// Validate ranges before concurrent workers see them.
+	for _, r := range memoryTarget.Ranges {
+		if r.Length == 0 {
+			return nil, fmt.Errorf("zero-length range at %d", r.Offset)
+		}
+		if r.Offset%PageSize != 0 {
+			return nil, fmt.Errorf("range offset %d is not page-aligned", r.Offset)
+		}
+		if r.Length%PageSize != 0 {
+			return nil, fmt.Errorf("range length %d is not page-aligned", r.Length)
+		}
+		if r.Offset > memoryTarget.Size || r.Length > memoryTarget.Size-r.Offset {
+			return nil, fmt.Errorf("range exceeds memory size")
+		}
+	}
+
+	// Check overlap on an address-sorted copy, but retain the original order.
+	// Adjacent ranges may intentionally encode reverse/interleaved Guest access;
+	// merging them here would destroy the priority captured by Recorder.
+	byAddress := append([]Range(nil), memoryTarget.Ranges...)
+	sort.Slice(byAddress, func(i, j int) bool { return byAddress[i].Offset < byAddress[j].Offset })
+	for i := 1; i < len(byAddress); i++ {
+		previousEnd := byAddress[i-1].Offset + byAddress[i-1].Length
+		if previousEnd > byAddress[i].Offset {
+			return nil, fmt.Errorf("overlapping memory ranges at %d", byAddress[i].Offset)
+		}
+	}
+
+	return &prof, nil
+}
+
+func (p *MemoryProfile) MemoryTarget() *Target {
+	if p == nil {
+		return nil
+	}
+	for i := range p.Targets {
+		if p.Targets[i].Kind == "memory" {
+			return &p.Targets[i]
+		}
+	}
+	return nil
+}
