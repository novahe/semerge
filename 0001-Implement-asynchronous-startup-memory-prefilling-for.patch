+++// Start begins the recording session, clearing any previous state.
+++func (r *Recorder) Start() {
+++	r.mu.Lock()
+++	defer r.mu.Unlock()
+++	r.active = true
+++	r.started = true
+++	r.pages = make(map[uint64]uint32)
+++	r.orderCnt = 0
+++	r.droppedPages = 0
+++}
