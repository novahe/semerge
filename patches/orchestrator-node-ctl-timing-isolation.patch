+}
+
+func newLaunchTimeline(profile types.Profile, acceptedAt time.Time) *launchTimeline {
+	t := &launchTimeline{profile: profile, points: map[string]time.Time{}}
+	if !acceptedAt.IsZero() {
+		t.points["accepted"] = acceptedAt
+	}
+	return t
+}
+
+func (t *launchTimeline) point(name string, at time.Time) {
+	if t == nil || at.IsZero() {
+		return
+	}
+	t.points[name] = at
+}
+
+func (t *launchTimeline) export(launchMs float64) *types.LaunchTiming {
+	if t == nil {
+		return nil
+	}
+	out := &types.LaunchTiming{
+		Profile:  t.profile,
+		Points:   map[string]string{},
+		PhasesMs: map[string]float64{},
+	}
+	for name, at := range t.points {
+		out.Points[name] = at.UTC().Format(time.RFC3339Nano)
+	}
+	add := func(name, from, to string) {
+		a, aok := t.points[from]
+		b, bok := t.points[to]
+		if !aok || !bok || b.Before(a) {
+			return
+		}
+		out.PhasesMs[name] = float64(b.Sub(a).Microseconds()) / 1000.0
+		out.AccountedMs += out.PhasesMs[name]
+	}
+	add("admission_to_node_prepare", "accepted", "node_prepare_done")
+	add("runner_wait", "runner_assign_start", "runner_commit_start")
+	add("runner_commit", "runner_commit_start", "runner_commit_done")
+	add("runner_handoff", "runner_commit_done", "runner_handoff_done")
+	add("sandbox_ctl_dispatch", "runner_handoff_done", "sandbox_ctl_start")
+	add("sandbox_ctl_pre_ch", "sandbox_ctl_start", "ch_start")
+	if _, ok := t.points["ch_resume_done"]; ok {
+		add("ch_start_to_resume", "ch_start", "ch_resume_done")
+		add("resume_to_sandbox_init_ack", "ch_resume_done", "sandbox_init_ack")
+		add("sandbox_init_ack_to_runtime_ready", "sandbox_init_ack", "runtime_ready_received")
+	} else {
+		add("ch_start_to_runtime_ready", "ch_start", "runtime_ready_received")
+	}
+	if _, ok := t.points["envd_init_done"]; ok {
+		add("runtime_ready_to_envd_init_done", "runtime_ready_received", "envd_init_done")
+		add("envd_init_to_launch_done", "envd_init_done", "launch_done")
+	} else {
+		add("runtime_ready_to_launch_done", "runtime_ready_received", "launch_done")
+	}
+	out.UnaccountedMs = launchMs - out.AccountedMs
+	return out
+}
