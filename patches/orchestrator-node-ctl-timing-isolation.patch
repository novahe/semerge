+// cgroupPathHasUnitPrefix limits orphan recovery to the top-level systemd
+// service directories owned by this node-ctl instance. Runner units from
+// multiple deployments intentionally share sandbox-runner.slice because the
+// runner cgroup contract requires that parent slice; the deployment-specific
+// unit prefix is therefore the isolation boundary for inventory scanning.
+func cgroupPathHasUnitPrefix(root, path, prefix string) bool {
+	rel, err := filepath.Rel(root, path)
+	if err != nil || rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return false
+	}
+	first := rel
+	if idx := strings.IndexRune(first, filepath.Separator); idx >= 0 {
+		first = first[:idx]
+	}
+	return strings.HasPrefix(first, prefix)
+}
