+func TestColdZeroTailUsesBoundedWindow(t *testing.T) {
+	for _, tt := range []struct {
+		name        string
+		pages       uint64
+		boundary    uint64
+		regionPages uint64
+		fallback    bool
+		wantPages   uint64
+	}{
+		{name: "full window", pages: 260, wantPages: 256},
+		{name: "RAM end", pages: 20, wantPages: 20},
+		{name: "loaded boundary", pages: 68, boundary: 40, wantPages: 40},
+		{name: "CH region boundary", pages: 68, regionPages: 32, wantPages: 32},
+		{name: "copy fallback", pages: 260, fallback: true, wantPages: 256},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			h := newUnitHandlerWithoutMap(t, tt.pages*PageSize, ZeroSource{})
+			regionPages := tt.pages
+			if tt.regionPages != 0 {
+				regionPages = tt.regionPages
+			}
+			if err := registerUnitRegion(h, ProcessCH, unitCHVA, regionPages*PageSize, 0); err != nil {
+				t.Fatal(err)
+			}
+			if tt.boundary != 0 {
+				h.state.Set(tt.boundary, StateLoaded)
+			}
+			ioctls := newFakeIoctls()
+			if tt.fallback {
+				ioctls.zeroHook = func(int, uint64, uint64) (int64, error) { return 0, unix.EOPNOTSUPP }
+			}
+			h.ops = ioctls.ops()
+			h.handleFault(faultEvent{address: unitCHVA, uffdFD: unitFD}, make([]byte, PageSize))
+			startUnitTail(t, h)
+			waitUnitTail(t, h)
+			calls := ioctls.snapshot()
+			if tt.fallback {
+				filtered := calls[:0]
+				for _, call := range calls {
+					if call.kind == "copy" {
+						if !bytes.Equal(call.data, make([]byte, len(call.data))) {
+							t.Fatal("fallback copied nonzero bytes")
+						}
+						filtered = append(filtered, call)
+					}
+				}
+				calls = filtered
+			}
+			if len(calls) != 2 || calls[0].length != PageSize || calls[1].length != (tt.wantPages-1)*PageSize {
+				t.Fatalf("cold zero call count = %d, want 1+%d pages", len(calls), tt.wantPages-1)
+			}
+			for page := uint64(0); page < tt.wantPages; page++ {
+				if h.state.Get(page) != StateLoaded {
+					t.Fatalf("page %d not loaded", page)
+				}
+			}
+			if tt.wantPages < tt.pages && tt.wantPages != tt.boundary && h.state.Get(tt.wantPages) != StateAbsent {
+				t.Fatal("cold prefill crossed its bound")
+			}
+		})
+	}
+}
