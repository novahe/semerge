 // Size of a PFN in the balloon interface.
 const VIRTIO_BALLOON_PFN_SHIFT: u64 = 12;
 
+// Bound logical release publication and keep temporary state constant-sized.
+const MAX_INFLATE_RUN_BYTES: usize = 256 << VIRTIO_BALLOON_PFN_SHIFT;
+
+#[derive(Debug)]
+struct InflateRun {
+    base: GuestAddress,
+    len: usize,
+    region_start: GuestAddress,
+}
+
+impl InflateRun {
+    fn new(base: GuestAddress, region_start: GuestAddress) -> Self {
+        Self { base, len: 1 << VIRTIO_BALLOON_PFN_SHIFT, region_start }
+    }
+
+    fn extend(&mut self, base: GuestAddress, region_start: GuestAddress) -> bool {
+        let page = 1 << VIRTIO_BALLOON_PFN_SHIFT;
+        if self.region_start != region_start || self.len >= MAX_INFLATE_RUN_BYTES {
+            return false;
+        }
+        if self.base.checked_add(self.len as u64) == Some(base) {
+            self.len += page;
+            return true;
+        }
+        if base.checked_add(page as u64) == Some(self.base) {
+            self.base = base;
+            self.len += page;
+            return true;
+        }
+        false
+    }
+}
