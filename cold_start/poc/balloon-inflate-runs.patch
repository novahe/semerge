+    fn release_inflate_pfn(
+        pbp: &mut Option<PartiallyBalloonedPage>,
+        pending: &mut Option<InflateRun>,
+        memory: &GuestMemoryMmap,
+        pfn: u32,
+    ) -> result::Result<(), Error> {
+        // A larger host page may contain PFNs the guest has not returned.
+        // Preserve its existing partial-page ownership tracking unchanged.
+        if get_page_size() != 1 << VIRTIO_BALLOON_PFN_SHIFT {
+            return Self::release_memory_range_4k(pbp, memory, pfn);
+        }
+        let base = GuestAddress((pfn as u64) << VIRTIO_BALLOON_PFN_SHIFT);
+        let region = memory.find_region(base).ok_or(Error::GuestMemory(
+            GuestMemoryError::InvalidGuestAddress(base),
+        ))?;
+        if let Some(run) = pending.as_mut()
+            && run.extend(base, region.start_addr())
+        {
+            return Ok(());
+        }
+        Self::flush_inflate_run(memory, pending)?;
+        *pending = Some(InflateRun::new(base, region.start_addr()));
+        Ok(())
+    }
